# --- Node / frontend -------------------------------------------------------
node_modules
dist
dist-ssr
*.local

# --- Logs ------------------------------------------------------------------
logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*

# --- Rust / Tauri build artifacts ------------------------------------------
# The cargo workspace lives under src-tauri/, so that is where target/ is.
src-tauri/target/
# Tauri writes updater diagnostics here when signing is enabled.
updater-diagnostics/
# Staging directories used by the release pipeline and by build.bat.
/release/
/release-artifact/
/release-artifacts/
# Generated by `tauri build`; only the sources are tracked.
src-tauri/gen/schemas

# --- Secrets ---------------------------------------------------------------
# The Tauri updater private key. The matching public key (src-tauri/tauri.pubkey)
# IS committed; the private key must never enter the repository - it lives in the
# TAURI_SIGNING_PRIVATE_KEY CI secret (or in a local src-tauri/tauri.key).
*.key
.env
.env.*
*.pem
*.pfx

# --- Editor and OS files ---------------------------------------------------
.vscode/*
!.vscode/extensions.json
.idea
.DS_Store
Thumbs.db
desktop.ini
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?

# --- WorkBuddy session data ------------------------------------------------
.workbuddy
